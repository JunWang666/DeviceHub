<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeviceHub.Plugin.Quectel.Ui.QuectelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceHub.Plugin.Quectel.Ui"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <x:Double x:Key="CardSpacing">4</x:Double>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,30,0,6"/>
        </Style>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PaneStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头：型号、注册状态、刷新、最近一次操作的结果 -->
        <StackPanel Spacing="6">
            <InfoBar IsOpen="{x:Bind Vm.ShowUnauthorized, Mode=OneWay}" Severity="Warning" IsClosable="False"
                     Title="未授权" Message="插件尚未获得此模块 AT 口的访问授权。"/>
            <InfoBar IsOpen="{x:Bind Vm.DriverMissing, Mode=OneWay}" Severity="Error" IsClosable="False"
                     Title="模块驱动未安装" Message="{x:Bind Vm.DriverMessage, Mode=OneWay}"/>
            <Grid Margin="1,0,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Vm.SignalGlyph, Mode=OneWay}" FontSize="28" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Vm.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind Vm.ConnectionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ProgressRing Grid.Column="2" IsActive="{x:Bind Vm.Busy, Mode=OneWay}" Width="20" Height="20"/>
                <Button Grid.Column="3" VerticalAlignment="Center" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,0"/>
        </StackPanel>

        <SelectorBar x:Name="Sections" Grid.Row="1" SelectionChanged="Sections_SelectionChanged">
            <SelectorBarItem x:Name="StatusTab" Text="状态" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE9D9;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="LockTab" Text="锁定">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE72E;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="SmsTab" Text="短信">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8BD;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="GpsTab" Text="定位">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE707;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="SettingsTab" Text="设置">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="AdvancedTab" Text="高级">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE756;"/></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- 状态：信号概览、服务小区、邻区 -->
        <ScrollViewer x:Name="StatusPanel" Grid.Row="2">
            <StackPanel Spacing="{StaticResource CardSpacing}" Margin="0,0,0,36">
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="104" Margin="0,0,0,4">
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="信号" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{x:Bind Vm.RsrpText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Vm.SignalCaption, Mode=OneWay}" Style="{StaticResource TileCaption}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="运营商" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{x:Bind Vm.OperatorText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Vm.OperatorCaption, Mode=OneWay}" Style="{StaticResource TileCaption}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="IP 地址" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{x:Bind Vm.IpText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind Vm.IpCaption, Mode=OneWay}" Style="{StaticResource TileCaption}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileStyle}" Margin="0,0,8,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="温度" Style="{StaticResource TileLabel}"/>
                            <TextBlock Text="{x:Bind Vm.TempText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Vm.TempCaption, Mode=OneWay}" Style="{StaticResource TileCaption}"/>
                        </StackPanel>
                    </Border>
                </VariableSizedWrapGrid>

                <!-- 电脑联网：结论 + 一键修复（建议的网卡模式）+ 依据 -->
                <InfoBar IsOpen="{x:Bind Vm.PcKnown, Mode=OneWay}" IsClosable="False" Severity="{x:Bind Vm.PcSeverity, Mode=OneWay}"
                         Title="{x:Bind Vm.PcSummary, Mode=OneWay}" Message="{x:Bind Vm.PcAdvice, Mode=OneWay}" Margin="0,0,0,4">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind Vm.PcFixText, Mode=OneWay}" Click="PcFix_Click"
                                Visibility="{x:Bind local:QuectelPage.Show(Vm.PcCanFix), Mode=OneWay}"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <tk:SettingsExpander Header="电脑联网" Description="Windows 能否通过模块上网">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE839;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Windows 网卡">
                            <TextBlock Text="{x:Bind Vm.PcAdapter, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="网卡状态">
                            <TextBlock Text="{x:Bind Vm.PcAdapterState, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="模块数据连接" Description="模块向运营商拨号拿到的地址">
                            <TextBlock Text="{x:Bind Vm.PcModuleIp, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="USB 网卡模式" Description="在「设置」里修改">
                            <TextBlock Text="{x:Bind Vm.IpCaption, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="服务小区" Description="{x:Bind Vm.ServingPciText, Mode=OneWay}" IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE704;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="注册状态">
                            <TextBlock Text="{x:Bind Vm.RegistrationText, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="PLMN">
                            <TextBlock Text="{x:Bind Vm.ServingPlmn, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="小区 ID">
                            <TextBlock Text="{x:Bind Vm.ServingCellText, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="RRC 状态">
                            <TextBlock Text="{x:Bind Vm.ServingStateText, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="邻区" ItemsSource="{x:Bind Vm.Neighbours, Mode=OneWay}"
                                     Description="模块测量到的同频 / 异频小区；可直接锁定到某个小区">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE81E;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.ItemsHeader>
                        <TextBlock Text="暂无邻区数据" Margin="58,12,16,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:QuectelPage.Hide(Vm.HasNeighbours), Mode=OneWay}"/>
                    </tk:SettingsExpander.ItemsHeader>
                    <tk:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="local:NeighbourRow">
                            <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Detail}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Badge}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <Button Content="锁定此小区" Tag="{x:Bind Cell}" Click="LockNeighbour_Click" IsEnabled="{x:Bind CanLockCell}"/>
                                </StackPanel>
                            </tk:SettingsCard>
                        </DataTemplate>
                    </tk:SettingsExpander.ItemTemplate>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 锁定：频段、小区 / 频点 -->
        <ScrollViewer x:Name="LockPanel" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Spacing="{StaticResource CardSpacing}" Margin="0,0,0,36">
                <tk:SettingsExpander Header="频段锁定" Description="{x:Bind Vm.BandsDescription, Mode=OneWay}" IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9E9;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                            <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind Vm.Bands, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="76"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:BandItem">
                                            <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" MinWidth="0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="应用所选频段" Style="{StaticResource AccentButtonStyle}" Click="ApplyBands_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                                    <Button Content="恢复全部频段" Click="RestoreBands_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="小区 / 频点锁定" Description="{x:Bind Vm.LockDescription, Mode=OneWay}" IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE72E;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="EARFCN 与 PCI" Description="PCI 留空时只锁频点；也可以在「状态」页的邻区列表里直接锁定">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="EarfcnBox" PlaceholderText="EARFCN" Minimum="0" Maximum="262143" Width="110"/>
                                <NumberBox x:Name="PciBox" PlaceholderText="PCI" Minimum="0" Maximum="503" Width="90"/>
                                <Button Content="填入当前小区" Click="UseServing_Click"/>
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="锁定" Style="{StaticResource AccentButtonStyle}" Click="Lock_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                                <Button Content="解除锁定" Click="Unlock_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 短信：左会话列表，右聊天气泡 + 输入框 -->
        <Grid x:Name="SmsPanel" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="12" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="12,10" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="信息" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Vm.SmsDescription, Mode=OneWay}" Style="{StaticResource TileCaption}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="LoadSms_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                ToolTipService.ToolTip="从模块读取短信（会把未读标为已读）" Padding="8,6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="2" Click="NewChat_Click" ToolTipService.ToolTip="新消息" Padding="8,6">
                            <FontIcon Glyph="&#xE932;" FontSize="14"/>
                        </Button>
                    </Grid>
                    <ListView x:Name="ThreadList" Grid.Row="1" ItemsSource="{x:Bind Vm.Threads, Mode=OneWay}"
                              SelectionMode="Single" SelectionChanged="ThreadList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ThreadRow">
                                <Grid ColumnSpacing="10" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="12"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Peer}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Preview}" Style="{StaticResource TileCaption}" MaxLines="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource TileCaption}" HorizontalAlignment="Right"/>
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right"
                                                 Visibility="{x:Bind UnreadVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="16"
                                Visibility="{x:Bind local:QuectelPage.Hide(Vm.SmsLoaded), Mode=OneWay}">
                        <TextBlock Text="还没读取模块里的短信" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="读取短信" HorizontalAlignment="Center" Click="LoadSms_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                        <TextBlock Text="读取会把未读短信标为已读；之后新短信会自动出现在这里" TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource TileCaption}" MaxWidth="220"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="没有短信" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind local:QuectelPage.Show(Vm.SmsEmpty), Mode=OneWay}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PaneStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 会话标题；新消息时是号码输入框 -->
                    <Grid Padding="16,10" MinHeight="56" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{x:Bind Vm.ChatTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True" Visibility="{x:Bind local:QuectelPage.Hide(Vm.IsNewChat), Mode=OneWay}"/>
                        <TextBox x:Name="SmsTo" PlaceholderText="收件人号码，如 +8613800000000" InputScope="TelephoneNumber" VerticalAlignment="Center"
                                 Visibility="{x:Bind local:QuectelPage.Show(Vm.ComposingNew), Mode=OneWay}"/>
                    </Grid>
                    <ListView x:Name="BubbleList" Grid.Row="1" ItemsSource="{x:Bind Vm.Bubbles, Mode=OneWay}" SelectionMode="None"
                              Padding="0,8" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="16,3"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:BubbleRow">
                                <Border HorizontalAlignment="{x:Bind Align}" MaxWidth="420" Padding="12,8" CornerRadius="12"
                                        Background="{x:Bind Background}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="复制" Tag="{x:Bind Message}" Click="CopySms_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="删除" Tag="{x:Bind Message}" Click="DeleteSms_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{x:Bind Foreground}"/>
                                        <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="{x:Bind MetaForeground}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="选择左侧的会话，或点 ✎ 发新消息" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind local:QuectelPage.Hide(Vm.HasChat), Mode=OneWay}"/>
                    <!-- 输入框：Enter 发送，Shift+Enter 换行 -->
                    <Grid Grid.Row="2" Padding="12" ColumnSpacing="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                          Visibility="{x:Bind local:QuectelPage.Show(Vm.HasChat), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SmsText" PlaceholderText="短信（最多 70 字，Enter 发送）" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxLength="70" MaxHeight="120" PreviewKeyDown="SmsText_PreviewKeyDown" TextChanged="SmsText_TextChanged"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
                            <TextBlock x:Name="SmsCount" Text="0/70" Style="{StaticResource TileCaption}" HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="SendSms_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                    ToolTipService.ToolTip="发送（按运营商资费收费）">
                                <FontIcon Glyph="&#xE724;" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 定位 -->
        <ScrollViewer x:Name="GpsPanel" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Spacing="{StaticResource CardSpacing}" Margin="0,0,0,36">
                <tk:SettingsCard Header="GPS / GNSS" Description="{x:Bind Vm.GpsDescription, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE707;"/></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="GpsSwitch" OnContent="开" OffContent="关" MinWidth="0" IsOn="{x:Bind Vm.GpsOn, Mode=OneWay}"
                                  Toggled="Gps_Toggled" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="坐标" Description="{x:Bind Vm.GpsDetail, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81D;"/></tk:SettingsCard.HeaderIcon>
                    <TextBlock Text="{x:Bind Vm.GpsPosition, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                </tk:SettingsCard>
                <TextBlock Text="定位数据只在本机显示，不会上传。NMEA 原始数据从模块的 NMEA 口（USB 接口 1）输出。" TextWrapping="Wrap"
                           Style="{StaticResource TileCaption}" Margin="1,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 设置：网络、SIM、模块 -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Spacing="{StaticResource CardSpacing}" Margin="0,0,0,36">
                <TextBlock Text="网络" Style="{StaticResource GroupHeaderStyle}" Margin="1,0,0,6"/>
                <tk:SettingsCard Header="网络制式" Description="{x:Bind Vm.ImsText, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8CE;"/></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ScanModeBox" MinWidth="140" SelectedIndex="{x:Bind Vm.ScanModeIndex, Mode=OneWay}"
                              SelectionChanged="ScanMode_Changed" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}">
                        <ComboBoxItem Content="自动"/>
                        <ComboBoxItem Content="仅 LTE"/>
                        <ComboBoxItem Content="仅 WCDMA"/>
                        <ComboBoxItem Content="仅 GSM"/>
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="漫游">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE909;"/></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="RoamingBox" MinWidth="140" SelectedIndex="{x:Bind Vm.RoamingIndex, Mode=OneWay}"
                              SelectionChanged="Roaming_Changed" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}">
                        <ComboBoxItem Content="自动"/>
                        <ComboBoxItem Content="允许漫游"/>
                        <ComboBoxItem Content="禁止漫游"/>
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="飞行模式" Description="关闭射频（AT+CFUN=4），断开蜂窝网络">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE709;"/></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AirplaneSwitch" OnContent="开" OffContent="关" MinWidth="0" IsOn="{x:Bind Vm.AirplaneOn, Mode=OneWay}"
                                  Toggled="Airplane_Toggled" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="USB 网卡模式" Description="重启模块后生效。Windows 自带 RNDIS 驱动；大疆设备上使用时需要 ECM">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE839;"/></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="UsbNetBox" MinWidth="140" SelectedIndex="{x:Bind Vm.UsbNetIndex, Mode=OneWay}"
                              SelectionChanged="UsbNet_Changed" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}">
                        <ComboBoxItem Content="RmNet / QMI"/>
                        <ComboBoxItem Content="ECM"/>
                        <ComboBoxItem Content="MBIM"/>
                        <ComboBoxItem Content="RNDIS"/>
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="重启模块" Description="USB 会断开约 20 秒，之后自动重新接管">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE777;"/></tk:SettingsCard.HeaderIcon>
                    <Button Content="重启" Click="Reboot_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                </tk:SettingsCard>

                <TextBlock Text="SIM 与模块" Style="{StaticResource GroupHeaderStyle}"/>
                <tk:SettingsExpander Header="SIM 卡" Description="{x:Bind Vm.SimState, Mode=OneWay}">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE1D8;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="IMSI"><TextBlock Text="{x:Bind Vm.Imsi, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="ICCID"><TextBlock Text="{x:Bind Vm.Iccid, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="本机号码"><TextBlock Text="{x:Bind Vm.Number, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="短信中心"><TextBlock Text="{x:Bind Vm.Smsc, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsExpander Header="模块信息" Description="{x:Bind Vm.Revision, Mode=OneWay}">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE950;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="IMEI"><TextBlock Text="{x:Bind Vm.Imei, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="运营商配置（MBN）"><TextBlock Text="{x:Bind Vm.Mbn, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="USB 配置" Description="VID, PID, DIAG, NMEA, AT, Modem, 网卡, ADB, UAC"><TextBlock Text="{x:Bind Vm.UsbConfig, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                        <tk:SettingsCard Header="制式搜索顺序" Description="01 GSM · 02 TD-SCDMA · 03 WCDMA · 04 LTE · 05 CDMA"><TextBlock Text="{x:Bind Vm.ScanSequence, Mode=OneWay}" Style="{StaticResource ValueText}"/></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- 高级：AT 控制台，占满剩余高度 -->
        <Grid x:Name="AdvancedPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="直接向模块发送 AT 命令。写入类命令会改变模块设置，请确认含义后再执行。" TextWrapping="Wrap"
                       Style="{StaticResource TileCaption}" Margin="1,0,0,0"/>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AtInput" PlaceholderText="AT+QENG=&quot;servingcell&quot;" FontFamily="Consolas" KeyDown="AtInput_KeyDown"/>
                <Button Grid.Column="1" Content="执行" Style="{StaticResource AccentButtonStyle}" Click="RunAt_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"/>
                <Button Grid.Column="2" Content="清空" Click="ClearConsole_Click"/>
            </Grid>
            <TextBox Grid.Row="2" Text="{x:Bind Vm.ConsoleText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                     AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
