{
  "id": "com.devicehub.logitech",
  "displayName": "罗技设备",
  "version": "1.4.0",
  "sdkVersion": "1.0",
  "backendAssembly": "backend/DeviceHub.Plugin.Logitech.dll",
  "backendType": "DeviceHub.Plugin.Logitech.LogitechPlugin",
  "uiAssembly": "ui/DeviceHub.Plugin.Logitech.Ui.dll",
  "uiPageType": "DeviceHub.Plugin.Logitech.Ui.LogitechPageEntry",
  "uiWidgetType": "DeviceHub.Plugin.Logitech.Ui.LogitechWidgets",
  "widgets": [
    { "id": "battery", "title": "电量", "description": "设备电量；放在接收器上时显示所有配对设备", "glyph": "", "sizes": ["small", "wide", "large"], "defaultSize": "small" },
    { "id": "dpi", "title": "DPI", "description": "查看并切换鼠标 DPI", "glyph": "", "sizes": ["wide"], "defaultSize": "wide" }
  ],
  "devices": [
    {
      "name": "罗技设备（HID++）",
      "bus": "Hid",
      "vid": "0x046d",
      "channels": [
        { "role": "long", "usagePage": "0xff00", "usage": "0x02" },
        { "role": "short", "usagePage": "0xff00", "usage": "0x01", "optional": true }
      ]
    },
    {
      "name": "罗技蓝牙设备（HID++）",
      "bus": "Hid",
      "vid": "0x046d",
      "channels": [
        { "role": "long", "usagePage": "0xff43", "usage": "0x0202" }
      ]
    }
  ],
  "permissions": ["devices"]
}
