<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeviceHub.Plugin.Logitech.Ui.LogitechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeviceHub.Plugin.Logitech.Ui"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <!-- 设置卡片之间 4px、分组之间 30px（WinUI 设置页规范） -->
        <x:Double x:Key="CardSpacing">4</x:Double>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,30,0,6"/>
        </Style>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <!-- 设备名称和副标题由 DeviceHub 的页头显示，这里不再重复，只放分页和一行连接信息 -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Sections" Visibility="{x:Bind Vm.IsPointer, Mode=OneWay}" SelectionChanged="Sections_SelectionChanged">
                <SelectorBarItem x:Name="SettingsTab" Text="设置" IsSelected="True">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;"/></SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="TestTab" Text="按键测试">
                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE962;"/></SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <TextBlock Visibility="{x:Bind Vm.IsNotPointer, Mode=OneWay}" Text="{x:Bind Vm.SummaryText, Mode=OneWay}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="1,0,0,0"/>
            <Button Grid.Column="1" VerticalAlignment="Center" Click="Refresh_Click" ToolTipService.ToolTip="重新读取设备信息与设置">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="重新读取"/>
                </StackPanel>
            </Button>
        </Grid>

    <ScrollViewer x:Name="SettingsPanel" Grid.Row="1">
        <StackPanel Spacing="{StaticResource CardSpacing}" Margin="0,0,0,36">
            <InfoBar IsOpen="{x:Bind Vm.ShowUnauthorized, Mode=OneWay}" Severity="Warning" IsClosable="False"
                     Title="未授权" Message="插件尚未获得此设备的访问授权。" Margin="0,0,0,8"/>
            <TextBlock Visibility="{x:Bind Vm.IsPointer, Mode=OneWay}" Text="{x:Bind Vm.SummaryText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="1,0,0,4"/>

            <!-- 接收器：配对表。每个配对设备在左侧导航里是接收器下的独立设备，设置在那里改 -->
            <StackPanel Visibility="{x:Bind Vm.ShowPaired, Mode=OneWay}" Spacing="{StaticResource CardSpacing}">
                <TextBlock Text="配对设备" Style="{StaticResource GroupHeaderStyle}" Margin="1,8,0,2"/>
                <TextBlock Text="在左侧接收器下选择设备，可调整它的 DPI、滚轮等设置。" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,6" TextWrapping="Wrap"/>
                <ItemsRepeater ItemsSource="{x:Bind Vm.PairedRows, Mode=OneWay}">
                    <ItemsRepeater.Layout><StackLayout Spacing="{StaticResource CardSpacing}"/></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:PairedRow">
                            <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Detail}" Opacity="{x:Bind Opacity}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="{x:Bind Glyph}"/></tk:SettingsCard.HeaderIcon>
                                <Button Content="取消配对" Visibility="{x:Bind CanUnpair}" Click="Unpair_Click"/>
                            </tk:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
            <!-- 配对新设备（Unifying） -->
            <tk:SettingsCard Visibility="{x:Bind Vm.ShowPairing, Mode=OneWay}" Margin="0,8,0,0"
                             Header="配对新设备" Description="{x:Bind Vm.PairingDescription, Mode=OneWay}">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE710;"/></tk:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind Vm.PairingOpen, Mode=OneWay}" Visibility="{x:Bind Vm.PairingOpen, Mode=OneWay}" Width="20" Height="20"/>
                    <Button Content="开始配对" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind Vm.PairingIdle, Mode=OneWay}" Click="StartPairing_Click"/>
                    <Button Content="停止" Visibility="{x:Bind Vm.PairingOpen, Mode=OneWay}" Click="StopPairing_Click"/>
                </StackPanel>
            </tk:SettingsCard>
            <InfoBar IsOpen="{x:Bind Vm.ShowNoDevices, Mode=OneWay}" Severity="Informational" IsClosable="False"
                     Title="没有配对设备" Message="这个接收器上没有已配对的设备。"/>

            <!-- 设备概览 -->
            <StackPanel Visibility="{x:Bind Vm.HasDevice, Mode=OneWay}" Spacing="{StaticResource CardSpacing}" Margin="0,4,0,0">
                <InfoBar IsOpen="{x:Bind Vm.DeviceOffline, Mode=OneWay}" Severity="Informational" IsClosable="False"
                         Title="设备未连接" Message="{x:Bind Vm.OfflineText, Mode=OneWay}"/>

                <Border Style="{StaticResource TileStyle}" HorizontalAlignment="Left" Visibility="{x:Bind Vm.HasBattery, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="电量" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Vm.BatteryGlyph, Mode=OneWay}" FontSize="22"/>
                            <TextBlock Text="{x:Bind Vm.BatteryText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>
                        <ProgressBar Value="{x:Bind Vm.BatteryValue, Mode=OneWay}" Maximum="100" Visibility="{x:Bind Vm.BatteryKnown, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Vm.BatteryDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 指针 -->
            <StackPanel Visibility="{x:Bind Vm.DeviceOnline, Mode=OneWay}" Spacing="{StaticResource CardSpacing}">
                <TextBlock Text="指针" Style="{StaticResource GroupHeaderStyle}" Visibility="{x:Bind Vm.HasDpi, Mode=OneWay}"/>
                <tk:SettingsCard Header="DPI" Description="{x:Bind Vm.DpiDescription, Mode=OneWay}" Visibility="{x:Bind Vm.HasDpi, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;"/></tk:SettingsCard.HeaderIcon>
                    <Grid>
                        <ComboBox MinWidth="140" Visibility="{x:Bind Vm.DpiDiscrete, Mode=OneWay}"
                                  ItemsSource="{x:Bind Vm.DpiChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.DpiIndex, Mode=TwoWay}"/>
                        <NumberBox MinWidth="140" SpinButtonPlacementMode="Inline" Visibility="{x:Bind Vm.DpiRange, Mode=OneWay}"
                                   Minimum="{x:Bind Vm.DpiMin, Mode=OneWay}" Maximum="{x:Bind Vm.DpiMax, Mode=OneWay}"
                                   SmallChange="{x:Bind Vm.DpiStep, Mode=OneWay}" LargeChange="{x:Bind Vm.DpiStep, Mode=OneWay}"
                                   Value="{x:Bind Vm.DpiValue, Mode=TwoWay}"/>
                    </Grid>
                </tk:SettingsCard>
                <tk:SettingsCard Header="回报率" Description="设备向电脑报告位置的频率" Visibility="{x:Bind Vm.HasReportRate, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" ItemsSource="{x:Bind Vm.ReportRateChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ReportRateIndex, Mode=TwoWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="指针速度" Description="设备端的速度倍率（与系统鼠标速度叠加）" Visibility="{x:Bind Vm.HasPointerSpeed, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEC4A;"/></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Vm.PointerSpeedText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="44"/>
                        <Slider Width="200" Minimum="46" Maximum="511" StepFrequency="1" Value="{x:Bind Vm.PointerSpeed, Mode=TwoWay}"/>
                    </StackPanel>
                </tk:SettingsCard>

                <!-- 滚轮 -->
                <TextBlock Text="滚轮" Style="{StaticResource GroupHeaderStyle}" Visibility="{x:Bind Vm.HasSmartShift, Mode=OneWay}"/>
                <tk:SettingsExpander Header="SmartShift" Description="快速拨动滚轮时自动从棘轮切换到自由滚动"
                                     IsExpanded="True" Visibility="{x:Bind Vm.HasSmartShift, Mode=OneWay}">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8CB;"/></tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch OnContent="棘轮" OffContent="自由滚动" MinWidth="0" IsOn="{x:Bind Vm.Ratchet, Mode=TwoWay}"/>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="切换灵敏度" Description="数值越大越不容易切到自由滚动">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Vm.ThresholdText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="32"/>
                                <Slider Width="200" Minimum="1" Maximum="50" StepFrequency="1" Value="{x:Bind Vm.Threshold, Mode=TwoWay}"/>
                            </StackPanel>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <TextBlock Text="滚轮" Style="{StaticResource GroupHeaderStyle}" Visibility="{x:Bind Vm.HasWheelOnly, Mode=OneWay}"/>
                <tk:SettingsCard Header="反向滚动" Description="上下滚动方向互换（自然滚动）" Visibility="{x:Bind Vm.HasWheel, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;"/></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch OnContent="开" OffContent="关" MinWidth="0" IsOn="{x:Bind Vm.Inverted, Mode=TwoWay}"/>
                </tk:SettingsCard>
                <tk:SettingsCard Header="高精度滚动" Description="{x:Bind Vm.HiResDescription, Mode=OneWay}" Visibility="{x:Bind Vm.HasWheel, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B0;"/></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch OnContent="开" OffContent="关" MinWidth="0" IsOn="{x:Bind Vm.HiRes, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <!-- 键盘 -->
                <TextBlock Text="键盘" Style="{StaticResource GroupHeaderStyle}" Visibility="{x:Bind Vm.HasFnSwap, Mode=OneWay}"/>
                <tk:SettingsCard Header="Fn 键反转" Description="开启后 F1–F12 直接输出功能键，按住 Fn 时为媒体/快捷功能"
                                 Visibility="{x:Bind Vm.HasFnSwap, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch OnContent="开" OffContent="关" MinWidth="0" IsOn="{x:Bind Vm.FnSwap, Mode=TwoWay}"/>
                </tk:SettingsCard>

                <!-- 连接 -->
                <TextBlock Text="连接与配置" Style="{StaticResource GroupHeaderStyle}" Visibility="{x:Bind Vm.HasConnectionGroup, Mode=OneWay}"/>
                <tk:SettingsCard Header="Easy-Switch 通道" Description="切换后设备会断开本机，连到所选通道配对的电脑"
                                 Visibility="{x:Bind Vm.HasHosts, Mode=OneWay}">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8AB;"/></tk:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="140" ItemsSource="{x:Bind Vm.HostChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.HostIndex, Mode=TwoWay}"/>
                </tk:SettingsCard>
                <tk:SettingsExpander Header="板载配置" Description="开启时设备使用内存中的配置；关闭（主机模式）后 DPI、回报率等由本软件设置"
                                     IsExpanded="True" Visibility="{x:Bind Vm.HasOnboard, Mode=OneWay}">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F8;"/></tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch OnContent="板载" OffContent="主机" MinWidth="0" IsOn="{x:Bind Vm.OnboardMode, Mode=TwoWay}"/>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="当前配置" Visibility="{x:Bind Vm.HasProfiles, Mode=OneWay}">
                            <ComboBox MinWidth="140" ItemsSource="{x:Bind Vm.ProfileChoices, Mode=OneWay}" SelectedIndex="{x:Bind Vm.ProfileIndex, Mode=TwoWay}"/>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- 诊断 -->
                <TextBlock Text="诊断" Style="{StaticResource GroupHeaderStyle}"/>
                <tk:SettingsExpander Header="HID++ Feature" Description="设备报告支持、且本插件识别的 Feature">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard>
                            <tk:SettingsCard.Header>
                                <TextBlock Text="{x:Bind Vm.FeaturesText, Mode=OneWay}" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            </tk:SettingsCard.Header>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <TextBlock Text="{x:Bind Vm.UnsupportedText, Mode=OneWay}" Visibility="{x:Bind Vm.HasUnsupported, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,6,0,0"/>
            </StackPanel>

            <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,8,0,0"/>
        </StackPanel>
    </ScrollViewer>

    <!-- 按键测试（鼠标 / 轨迹球）。面板在代码里放进来：App 运行时解析插件 XAML 时认不出插件自己定义的控件类型 -->
    <ScrollViewer x:Name="TestPanel" Grid.Row="1" Visibility="Collapsed">
        <StackPanel Spacing="12" Margin="0,0,0,36">
            <TextBlock Text="在下面的区域里点击、滚动、移动鼠标，检查每个按键和滚轮是否正常。系统不区分是哪只鼠标，接着几只时都会响应。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="1,0,0,0"/>
            <Border x:Name="MouseTestHost" Style="{StaticResource TileStyle}"/>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
