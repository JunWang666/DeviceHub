<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeviceHub.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="DeviceHub">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（Mica 透出） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE975;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="DeviceHub" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <!-- 只在连接失败/断开时出现 -->
        <InfoBar x:Name="ConnBar" Grid.Row="1" IsOpen="False" IsClosable="False" Margin="16,0,16,8"
                 Severity="Error" Title="未连接" Message="Agent 未运行或已断开。"/>

        <muxc:NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left"
                             IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                             IsPaneToggleButtonVisible="True" IsTitleBarAutoPaddingEnabled="False"
                             OpenPaneLength="260"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="主页" Tag="home">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="新设备" Tag="new">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE710;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="插件" Tag="plugins">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="USB" Tag="usb">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE88E;"/></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemSeparator x:Name="DeviceSeparator" Visibility="Collapsed"/>
                <muxc:NavigationViewItemHeader x:Name="DeviceHeader" Content="设备" Visibility="Collapsed"/>
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </muxc:NavigationView>
    </Grid>
</Window>
