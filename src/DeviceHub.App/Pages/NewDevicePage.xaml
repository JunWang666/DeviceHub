<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeviceHub.App.Pages.NewDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DeviceHub.Contracts"
    xmlns:svc="using:DeviceHub.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <DataTemplate x:Key="CandidateTemplate" x:DataType="c:PluginInfo">
            <StackPanel Spacing="2" Padding="0,6">
                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind Id}"/><Run Text=" · v"/><Run Text="{x:Bind Version}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="36,24,36,36" Spacing="4" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="新设备" Style="{StaticResource TitleTextBlockStyle}"/>
                <Button HorizontalAlignment="Right" Click="Refresh_Click" ToolTipService.ToolTip="重新扫描设备">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="已连接、可由插件管理但尚未授权的设备。添加后会出现在左侧，访问设备前都需要你的授权。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

            <ItemsControl x:Name="NewList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:NewDeviceRow">
                        <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Description}">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE765;"/></tk:SettingsCard.HeaderIcon>
                            <Button Content="添加" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind Device}" Click="Open_Click"/>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <tk:SettingsCard x:Name="EmptyHint" Header="没有发现新设备" Description="连接设备后点「刷新」。只有安装了对应插件的设备才会出现在这里。" Visibility="Collapsed">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;"/></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <TextBlock Text="已授权的设备" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,30,0,6"/>
            <ItemsControl x:Name="GrantList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:GrantRow">
                        <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Description}">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;"/></tk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="详情" Tag="{x:Bind Grant}" Click="Details_Click"/>
                                <Button Content="撤销授权" Tag="{x:Bind Grant}" Click="Revoke_Click"/>
                            </StackPanel>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoGrantHint" Text="还没有授权任何设备。" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="1,0,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
