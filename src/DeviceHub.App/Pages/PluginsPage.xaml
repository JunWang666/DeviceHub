<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeviceHub.App.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeviceHub.App.Services"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="1000" Margin="36,24,36,36" Spacing="4">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="插件" Style="{StaticResource TitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="Refresh_Click" ToolTipService.ToolTip="刷新插件状态">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="刷新"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Install_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="安装插件…"/>
                        </StackPanel>
                    </Button>
                    <Button Content="重启界面以应用更新" Click="Restart_Click"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="每个插件的后端运行在独立进程中，停止或崩溃不会影响 DeviceHub 和其他插件。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"/>

            <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:PluginRow">
                        <tk:SettingsCard Header="{x:Bind Title}" Description="{x:Bind Description}">
                            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEA86;"/></tk:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="启动" Tag="{x:Bind Plugin.Id}" Click="Start_Click" Visibility="{x:Bind CanStart}"/>
                                <Button Content="停止" Tag="{x:Bind Plugin.Id}" Click="Stop_Click" Visibility="{x:Bind CanStop}"/>
                            </StackPanel>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
