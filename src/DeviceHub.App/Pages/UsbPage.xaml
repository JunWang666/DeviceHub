<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeviceHub.App.Pages.UsbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DeviceHub.Contracts"
    xmlns:svc="using:DeviceHub.App.Services">
    <Grid Margin="36,24,36,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="USB" Style="{StaticResource TitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <ToggleSwitch x:Name="EmptyToggle" OnContent="显示空端口" OffContent="显示空端口" MinWidth="0"
                              Toggled="EmptyToggle_Toggled"/>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="重新扫描 USB">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="每个设备接在哪个接口、协商到多快、能不能更快。速率低于设备能力时，通常是线缆或接口限速。插拔设备后自动刷新。"/>

        <!-- 诊断汇总：有问题时逐条列出，点"查看"跳到对应设备 -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
            <InfoBar x:Name="AllGood" IsOpen="False" IsClosable="False" Severity="Success"
                     Title="一切正常" Message="所有设备都以它支持的最高速率运行。"/>
            <ItemsControl x:Name="IssueList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:UsbIssueRow">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind Severity}"
                                 Title="{x:Bind Title}" Message="{x:Bind Message}">
                            <InfoBar.ActionButton>
                                <Button Content="查看" Tag="{x:Bind Row}" Click="ShowIssue_Click"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="12" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <Grid>
                    <TreeView x:Name="Tree" SelectionMode="Single" ItemInvoked="Tree_ItemInvoked" CanDragItems="False" CanReorderItems="False">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="svc:UsbRow">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Opacity="{x:Bind TitleOpacity}"/>
                                        <StackPanel Grid.Column="1" Opacity="{x:Bind TitleOpacity}">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind IssueGlyph}" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                            <TextBlock Text="{x:Bind Badge}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <ProgressRing x:Name="Busy" IsActive="False" Width="32" Height="32"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer Padding="20,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DetailGlyph" FontSize="28" Glyph="&#xE88E;"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailTitle" Text="选择一个设备" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="CopyButton" Grid.Column="2" VerticalAlignment="Top" Visibility="Collapsed"
                                    Click="Copy_Click" ToolTipService.ToolTip="复制这些信息">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="DetailIssues">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:UsbIssueRow">
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind Severity}"
                                             Title="{x:Bind Issue.Title}" Message="{x:Bind Issue.Detail}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl x:Name="DetailList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:UsbDetail">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
