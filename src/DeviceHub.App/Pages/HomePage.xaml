<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeviceHub.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeviceHub.App.Services">
    <Page.Resources>
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,10,14,14"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <DataTemplate x:Key="OptionTemplate" x:DataType="svc:WidgetOption">
            <Grid ColumnSpacing="12" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="36,24,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="HintText" Text="右键小组件可调整大小、排序或移除。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Click="Add_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="添加小组件"/>
                </StackPanel>
            </Button>
            <ToggleButton x:Name="EditToggle" Grid.Column="2" VerticalAlignment="Top" Click="Edit_Click"
                          ToolTipService.ToolTip="拖动卡片排序，用卡片右上角的菜单调整大小或移除">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                    <TextBlock x:Name="EditText" Text="编辑"/>
                </StackPanel>
            </ToggleButton>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="-6,0,6,36">
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12" Margin="6,48,0,0" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE80F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="主页还是空的" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="把常用的设备信息放到这里：电量、灯效、降噪模式……插件提供哪些小组件，这里就能放哪些。"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="添加小组件" HorizontalAlignment="Center" Click="Add_Click"/>
                </StackPanel>
                <VariableSizedWrapGrid x:Name="Board" Orientation="Horizontal" ItemWidth="184" ItemHeight="160"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
